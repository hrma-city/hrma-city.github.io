<script id="rm-toc-script">
(function(){
  var d=document.getElementById('rm-toc-drawer'),t=document.getElementById('rm-toc-toggle');
  if(!d||!t)return;
  var c=d.querySelector('.toc-close');
  t.addEventListener('click',function(){d.classList.toggle('open')});
  if(c)c.addEventListener('click',function(){d.classList.remove('open')});
  var links=[].slice.call(d.querySelectorAll('.toc-body a'));
  var map=links.map(function(a){return {a:a,el:document.getElementById(a.getAttribute('href').slice(1))}}).filter(function(o){return o.el});
  function onScroll(){var cur=null;map.forEach(function(o){if(o.el.getBoundingClientRect().top<=150)cur=o.a;});
    links.forEach(function(a){a.classList.remove('active')});if(cur)cur.classList.add('active');}
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();
  links.forEach(function(a){a.addEventListener('click',function(){
    var el=document.getElementById(a.getAttribute('href').slice(1));
    if(el&&el.closest){var dd=el.closest('details');while(dd){dd.open=true;dd=dd.parentElement?dd.parentElement.closest('details'):null;}}
    d.classList.remove('open');
  });});
})();
</script>
