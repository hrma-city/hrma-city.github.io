# ============================================================================
# 支付网关密钥模板
# 复制为  .env  并填入真实值，然后用下面命令一次性注入 Supabase Secrets：
#   supabase secrets set --env-file ./supabase/.env --project-ref ivcylkcbodoacajyvnpy
# （不要把本文件提交到公开仓库；.env 已在 .gitignore 概念中，请勿推送明文密钥）
# ============================================================================

# 站点地址（用于拼接支付成功回跳）
SITE_URL=https://hrma-city.github.io

# ---------- Stripe ----------
# https://dashboard.stripe.com/apikeys  （测试用 sk_test_，上线换 sk_live_）
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks  新建端点后得到的签名密钥（whsec_...）
STRIPE_WEBHOOK_SECRET=

# ---------- 微信支付 v3（Native 扫码）----------
# 微信支付商户平台 → 账户中心 → 商户信息 → 商户号
WX_MCH_ID=
# 微信开放平台 / 公众号 / 小程序 的 AppID（Native 支付需已绑定商户号）
WX_APP_ID=
# 商户平台 → APIv3 密钥（32 位，用于解密回调报文）
WX_API_V3_KEY=
# 商户 API 证书序列号（apiclient_cert.pem 对应的序列号）
WX_SERIAL_NO=
# 商户 API 私钥（apiclient_key.pem 全文，含 BEGIN/END 行）
WX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# 回调地址（可不填，默认自动拼为 https://<project>.supabase.co/functions/v1/payment-webhook?gw=wechat）
WX_NOTIFY_URL=
# 微信平台证书公钥（从 https://api.mch.weixin.qq.com/v3/certificates 下载，PEM，用于验签）
WX_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# ---------- 支付宝（电脑网站支付）----------
# 支付宝开放平台 → 应用 → 查看 → APPID
ALIPAY_APP_ID=
# 应用私钥（应用公钥证书模式下的「应用私钥」，PKCS8 格式，单行 base64）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（开放平台「支付宝公钥」或「支付宝公钥证书」提取的 PEM，用于验签）
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
# 回调地址（可不填，默认自动拼）
ALIPAY_NOTIFY_URL=
